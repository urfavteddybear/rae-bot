# Rae Music Bot — Environment Configuration
# Copy this file to .env and fill in your values

# ─── Required ──────────────────────────────────────────────────────────────
BOT_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_application_id_here

# ─── Lavalink Nodes ────────────────────────────────────────────────────────
# JSON array of Lavalink node configs. You can run multiple nodes.
# Each object: { "host", "port", "authorization", "secure", "id" }
LAVALINK_NODES=[{"host":"lavalink","port":2333,"authorization":"youshallnotpass","secure":false,"id":"main"}]

# ─── Optional ──────────────────────────────────────────────────────────────
# Default source for play command: "dzsearch" (Deezer), "ytsearch" (YouTube),
# "scsearch" (SoundCloud), "amsearch" (Apple Music), "spsearch" (Spotify)
DEFAULT_SEARCH_ENGINE=dzsearch

# Your bot invite link (used by /invite command)
INVITE_URL=

# Support server invite (used by /help command)
SUPPORT_SERVER=

# Embed accent colour (hex without #)
ACCENT_COLOR=5865F2

# ─── Dashboard (optional) ──────────────────────────────────────────────────
# Setting CLIENT_SECRET enables the web dashboard.
# Discord Developer Portal > OAuth2: copy the client secret and add
# "<DASHBOARD_URL>/auth/callback" as a redirect.
CLIENT_SECRET=
# Public URL the dashboard is served from (no trailing slash)
DASHBOARD_URL=http://localhost:3000
WEB_PORT=3000
# Optional: key used to sign login cookies. Defaults to a hash of BOT_TOKEN.
SESSION_SECRET=

# ─── Security (optional) ───────────────────────────────────────────────────
# Number of reverse proxies in front of the dashboard (0 = none). Needed so rate
# limits see each visitor's real IP instead of the proxy's.
TRUST_PROXY=0
# Max tracks per server queue (slash commands and dashboard). Empty or 0 = unlimited
QUEUE_LIMIT=
# Extra hosts /play may load links from, comma separated (defaults cover Deezer,
# Spotify, Apple Music, YouTube, SoundCloud, Bandcamp, Twitch, Vimeo, Niconico)
ALLOWED_URL_HOSTS=
# Discord user IDs (comma separated) allowed to see Lavalink node addresses in /nodes
OWNER_IDS=
