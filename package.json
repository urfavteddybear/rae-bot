{
  "name": "rae-music-bot",
  "version": "1.0.0",
  "description": "A fast, lightweight Discord music bot powered by Lavalink",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "deploy": "node src/deploy-commands.js",
    "dev:web": "cd web && npm run dev",
    "build:web": "cd web && npm install && npm run build"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "lavalink-client": "^2.4.2",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
